# Create an API key at NVIDIA Build / API Catalog and keep it private.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: override local development keys. Leave blank to use keys in .secrets/.
GRADIENTHARBOR_HMAC_KEY=

# Optional hosted audio-language model; endpoint/model must support audio_url input.
NVIDIA_AUDIO_MODEL=google/gemma-3n-e4b-it
